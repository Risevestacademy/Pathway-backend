NODE_ENV=development
PORT=3000

POSTGRES_DB=pathway_dev
POSTGRES_USER=pathway_user
POSTGRES_PASSWORD=pathway_password
POSTGRES_PORT=5432
DATABASE_URL="postgresql://pathway_user:pathway_password@localhost:5432/pathway_dev?schema=public"
LOG_LEVEL=info

JWT_ACCESS_SECRET=access-secret
JWT_REFRESH_SECRET=refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

SENTRY_DSN=https://
SENTRY_ENVIRONMENT=development