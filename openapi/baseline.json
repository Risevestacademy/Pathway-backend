{
  "openapi": "3.0.0",
  "paths": {
    "/health/ping": {
      "get": {
        "operationId": "HealthController_ping",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/users/me": {
      "patch": {
        "operationId": "UsersController_updateMe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "The body failed validation"
          },
          "401": {
            "description": "Access token missing or invalid"
          },
          "404": {
            "description": "The user no longer exists"
          }
        },
        "summary": "Update the signed-in user's profile",
        "tags": [
          "Users"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [
          {
            "name": "X-Client-Platform",
            "in": "header",
            "description": "'mobile' carries the refresh token in the request body; 'web' or an absent header carries it in the HttpOnly cookie. Any other value is rejected with 400.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "mobile"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created. A six-digit verification code has been emailed. No authentication tokens are issued until the email is verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported X-Client-Platform value"
          },
          "409": {
            "description": "Email already registered"
          }
        },
        "summary": "Register a new user and send a verification code",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [
          {
            "name": "X-Client-Platform",
            "in": "header",
            "description": "'mobile' carries the refresh token in the request body; 'web' or an absent header carries it in the HttpOnly cookie. Any other value is rejected with 400.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "mobile"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully. Sets a refresh token cookie for web clients.",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh token cookie for web clients",
                "schema": {
                  "type": "string",
                  "example": "refreshToken=eyJhbGciOiJIUzI1Ni...; Path=/api/v1/auth; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported X-Client-Platform value"
          },
          "401": {
            "description": "Invalid credentials, or the email has not been verified."
          }
        },
        "summary": "Login a user",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/google": {
      "post": {
        "operationId": "AuthController_google",
        "parameters": [
          {
            "name": "X-Client-Platform",
            "in": "header",
            "description": "'mobile' carries the refresh token in the request body; 'web' or an absent header carries it in the HttpOnly cookie. Any other value is rejected with 400.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "mobile"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleAuthDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Google sign-in succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Google ID token is invalid or the email is not verified."
          }
        },
        "summary": "Sign in with Google",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [
          {
            "name": "X-Client-Platform",
            "in": "header",
            "description": "'mobile' carries the refresh token in the request body; 'web' or an absent header carries it in the HttpOnly cookie. Any other value is rejected with 400.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "mobile"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token refreshed successfully. Sets a new refresh token cookie for web clients.",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly rotated refresh token cookie for web clients",
                "schema": {
                  "type": "string",
                  "example": "refreshToken=eyJhbGciOiJIUzI1Ni...; Path=/api/v1/auth; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported X-Client-Platform value"
          },
          "401": {
            "description": "Refresh token required or invalid"
          }
        },
        "summary": "Refresh access token using refresh token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Every refresh token presented is revoked and the web refresh token cookie is cleared.",
            "headers": {
              "Set-Cookie": {
                "description": "Expired refresh token cookie for web clients",
                "schema": {
                  "type": "string",
                  "example": "refreshToken=; Path=/api/v1/auth; Expires=Thu, 01 Jan 1970 00:00:00 GMT"
                }
              }
            }
          }
        },
        "summary": "Logout a user",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/password-reset/request": {
      "post": {
        "operationId": "AuthController_requestPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Always returned for a valid email, whether or not an account exists. A reset link is emailed only when one does."
          },
          "400": {
            "description": "Email is missing or invalid"
          }
        },
        "summary": "Request a password reset email",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/password-reset/confirm": {
      "post": {
        "operationId": "AuthController_confirmPasswordReset",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmPasswordResetDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password updated. The reset token is marked used and all existing sessions are revoked."
          },
          "400": {
            "description": "Reset token is invalid, expired or already used, or the body failed validation"
          }
        },
        "summary": "Set a new password using a password reset token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/verify-email": {
      "post": {
        "operationId": "AuthController_verifyEmail",
        "parameters": [
          {
            "name": "X-Client-Platform",
            "in": "header",
            "description": "'mobile' carries the refresh token in the request body; 'web' or an absent header carries it in the HttpOnly cookie. Any other value is rejected with 400.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "web",
                "mobile"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified. Returns access (and for mobile, refresh) tokens, or sets a refresh token cookie for web clients.",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly refresh token cookie for web clients",
                "schema": {
                  "type": "string",
                  "example": "refreshToken=eyJhbGciOiJIUzI1Ni...; Path=/api/v1/auth; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Verification code is invalid, expired or already used"
          }
        },
        "summary": "Verify a user's email with a six-digit code",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/resend-verification": {
      "post": {
        "operationId": "AuthController_resendVerification",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Always returned, whether or not an account exists or is already verified. A new six-digit code is emailed only when appropriate."
          },
          "400": {
            "description": "Email is missing or invalid"
          }
        },
        "summary": "Resend the email verification code",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Access token missing or invalid, or the user no longer exists"
          }
        },
        "summary": "Get the signed-in user",
        "tags": [
          "Auth"
        ]
      }
    },
    "/fields": {
      "get": {
        "operationId": "FieldsController_getFields",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All career fields sorted by name. Returns an empty array if there are none.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FieldListItemDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Get all career fields",
        "tags": [
          "Fields"
        ]
      }
    },
    "/careers": {
      "get": {
        "operationId": "CareersController_getCareers",
        "parameters": [
          {
            "name": "level",
            "required": false,
            "in": "query",
            "description": "Filter by target level",
            "schema": {
              "enum": [
                "STUDENT",
                "RECENT_GRAD",
                "EARLY_CAREER"
              ],
              "type": "string"
            }
          },
          {
            "name": "interest",
            "required": false,
            "in": "query",
            "description": "Filter by field slug (e.g., \"software-engineering\")",
            "schema": {
              "example": "software-engineering",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of published careers. Returns an empty array if no matches are found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CareerListItemDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Get a public catalogue of published careers",
        "tags": [
          "Careers"
        ]
      }
    },
    "/careers/{id}": {
      "get": {
        "operationId": "CareersController_getCareerById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Career UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Career details including field, skills, outlook data, and a summary of the associated pathway.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareerDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Career does not exist, or exists but is not PUBLISHED."
          }
        },
        "summary": "Get details for a published career",
        "tags": [
          "Careers"
        ]
      }
    },
    "/careers/{careerId}/pathway": {
      "get": {
        "operationId": "CareersController_getCareerPathway",
        "parameters": [
          {
            "name": "careerId",
            "required": true,
            "in": "path",
            "description": "Career UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The career's pathway, wrapped as { pathway }. pathway is null if the career has no pathway yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CareerPathwayResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Career does not exist, or exists but is not PUBLISHED."
          }
        },
        "summary": "Get a published career's complete ordered pathway",
        "tags": [
          "Careers"
        ]
      }
    },
    "/target-levels": {
      "get": {
        "operationId": "TargetLevelsController_getTargetLevels",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Target level values accepted by the level filter on GET /careers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "STUDENT",
                      "RECENT_GRAD",
                      "EARLY_CAREER"
                    ]
                  },
                  "example": [
                    "STUDENT",
                    "RECENT_GRAD",
                    "EARLY_CAREER"
                  ]
                }
              }
            }
          }
        },
        "summary": "Get the target levels careers can be filtered by",
        "tags": [
          "Careers"
        ]
      }
    },
    "/pathway-steps/{stepId}": {
      "get": {
        "operationId": "PathwayStepsController_getPathwayStep",
        "parameters": [
          {
            "name": "stepId",
            "required": true,
            "in": "path",
            "description": "Pathway step UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The step with its skills and active resources, each resource with its skills.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PathwayStepDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "stepId is not a valid UUID."
          },
          "401": {
            "description": "Access token missing or invalid."
          },
          "404": {
            "description": "Step does not exist, or belongs to a career that is not PUBLISHED."
          }
        },
        "summary": "Get a single pathway step with its skills and resources",
        "tags": [
          "Pathway Steps"
        ]
      }
    },
    "/skills": {
      "get": {
        "operationId": "SkillsController_getSkills",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All skills sorted by name. Returns an empty array if there are none.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SkillListItemDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Get all skills",
        "tags": [
          "Skills"
        ]
      }
    },
    "/pathways/{pathwayId}": {
      "get": {
        "operationId": "PathwaysController_getPathwayMetadata",
        "parameters": [
          {
            "name": "pathwayId",
            "required": true,
            "in": "path",
            "description": "Pathway UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pathway metadata with slim ordered step summaries. Resources and full step detail are served by GET /pathway-steps/:stepId.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PathwayMetadataDto"
                }
              }
            }
          },
          "400": {
            "description": "pathwayId is not a valid UUID."
          },
          "404": {
            "description": "Pathway does not exist, or belongs to a career that is not PUBLISHED."
          }
        },
        "summary": "Get a published pathway's metadata and slim ordered steps (no resources or full step detail)",
        "tags": [
          "Pathways"
        ]
      }
    },
    "/onboarding/options": {
      "get": {
        "operationId": "ReferenceController_getOptions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Education, internship, and experience options with labels, plus skills and fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceOptionsDto"
                }
              }
            }
          }
        },
        "summary": "Get all options for the second onboarding screen",
        "tags": [
          "Onboarding"
        ]
      }
    }
  },
  "info": {
    "title": "Pathways API",
    "description": "API documentation for the Pathways backend",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Ada Obi",
            "description": "Full name, trimmed. 1 to 100 characters.",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "fullName"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "role": {
            "type": "string",
            "example": "USER"
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "Ada Obi"
          },
          "emailVerified": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "fullName",
          "emailVerified",
          "createdAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Ada Obi",
            "description": "Full name, trimmed. 1 to 100 characters.",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address."
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "description": "Account password. Must be at least 8 characters.",
            "minLength": 8
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Verification code sent"
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "message",
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address."
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "description": "Account password. Must be at least 8 characters."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1Ni..."
          },
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1Ni...",
            "description": "Returned to mobile clients only. Web clients receive it as an HttpOnly cookie."
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "GoogleAuthDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1Ni...",
            "description": "Required for mobile clients; web clients use the cookie."
          }
        }
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1Ni..."
          },
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1Ni...",
            "description": "Returned to mobile clients only. Web clients receive it as an HttpOnly cookie."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "RequestPasswordResetDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Email address of the account to reset."
          }
        },
        "required": [
          "email"
