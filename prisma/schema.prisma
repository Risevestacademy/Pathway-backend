generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EDITOR
  REVIEWER
  PUBLISHER
  ADMIN
}

enum ResourceType {
  COURSE
  CERTIFICATION
  ARTICLE
  VIDEO
  BOOK
}

enum PathwayStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SkillProgressSource {
  INITIAL_ASSESSMENT
  STEP_ASSESSMENT
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum CareerStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum TargetLevel {
  STUDENT
  RECENT_GRAD
  EARLY_CAREER
}

enum EducationLevel {
  SECONDARY_SCHOOL
  DIPLOMA
  BACHELOR_IN_PROGRESS
  BACHELOR
  MASTERS
  OTHER
}

enum InternshipCount {
  NONE
  ONE
  TWO
  THREE_PLUS
}

enum ExperienceYears {
  ZERO
  UNDER_ONE
  ONE_TO_TWO
  THREE_PLUS
}

enum OutlookType {
  SALARY
  EMPLOYMENT_GROWTH
  DEMAND
}

enum Demand {
  LOW
  MEDIUM
  HIGH
}

enum ResourceCostStatus {
  FREE
  PAID
  UNKNOWN
}

enum ResourceStatus {
  ACTIVE
  WITHDRAWN
}

enum AuthProvider {
  GOOGLE
}

enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  RESOLVED
}

enum FeedbackCategory {
  INCORRECT_CONTENT
  BROKEN_LINK
  USABILITY
  OTHER
}

enum FeedbackSection {
  CAREER_DETAILS
  OUTLOOK
  PATHWAY
  RESOURCES
  GENERAL
}

enum FeedbackPlatform {
  WEB
  IOS
  ANDROID
}

enum SkillImportance {
  REQUIRED
  NICE_TO_HAVE
}

enum RevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  role            Role      @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile               UserProfile?
  identities            AuthIdentity[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  passwordResetOtp      PasswordResetOtp[]
  emailVerificationOtps EmailVerificationOtp[]
  assessments           Assessment[]
  userSkills            UserSkill[]
  pathways              UserPathway[]
  pathwayProgress       UserPathwayStep[]
  verifiedSources       Source[]
  contentRevisions      ContentRevision[]
  reviews               Review[]
  staffInvites          StaffInvite[]
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  fullName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthIdentity {
  id             String       @id @default(uuid())
  provider       AuthProvider
  providerUserId String
  userId         String
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

model EmailVerificationOtp {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careerSkills      CareerSkill[]
  pathwayStepSkills PathwayStepSkill[]
  resourceSkills    ResourceSkill[]
  questions         AssessmentQuestion[]
  userSkills        UserSkill[]
}

model Field {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  careers Career[]
}

model Career {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  title                String   @unique
  description          String // card summary
  roleSummary          String // "What the role involves"
  exampleActivities    String[] // "Example work activities"
  typicalEducationNote String? // "Degree in computing... or bootcamps/self-study"
  certificationsNote   String? // "Rarely required. Portfolio matters more."

  fieldId      String
  field        Field         @relation(fields: [fieldId], references: [id])
  targetLevels TargetLevel[]

  status      CareerStatus @default(DRAFT)
  publishedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  version     Int          @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills       CareerSkill[]
  outlook      OutlookData[]
  pathway      Pathway?
  userPathways UserPathway[]
  feedback     ContentFeedback[]
  revisions    ContentRevision[]

  @@index([fieldId])
}

model CareerSkill {
  careerId   String
  skillId    String
  importance SkillImportance @default(REQUIRED)

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([careerId, skillId])
  @@index([skillId])
}

model OutlookData {
  id       String @id @default(uuid())
  careerId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  type      OutlookType
  geography String // "United States", "Lagos, Nigeria"
  sourceId  String?
  source    Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  period    String // "May 2024", "2023–2033", "Q2 2025"

  median          Decimal? @db.Decimal(15, 2)
  percentile25    Decimal? @db.Decimal(15, 2)
  percentile75    Decimal? @db.Decimal(15, 2)
  currency        String?
  payPeriod       String? // "year" | "month"
  grossOrNet      String? // "gross" | "net" | "unspecified"
  experienceLevel String? // "entry-level", "all experience levels"

  // EMPLOYMENT_GROWTH fields
  baseYear       Int?
  baseValue      Int? // e.g. 208 (thousands of jobs)
  projectedYear  Int?
  projectedValue Int? // e.g. 225
  growthPercent  Decimal? @db.Decimal(5, 2) // e.g., 8.00 for +8%

  // DEMAND fields
  demandLevel Demand?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([careerId])
}

model Pathway {
  id          String   @id @default(uuid())
  careerId    String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  career Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)
  steps  PathwayStep[]
}

model PathwayStep {
  id                String   @id @default(uuid())
  pathwayId         String
  title             String
  description       String?
  learningObjective String
  prerequisites     String?
  expectedActivity  String
  order             Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pathway      Pathway               @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  skills       PathwayStepSkill[]
  resources    PathwayStepResource[]
  progress     UserPathwayStep[]
  assessments  Assessment[]
  userPathways UserPathway[]

  @@unique([pathwayId, order])
}

model PathwayStepSkill {
  pathwayStepId String
  skillId       String

  pathwayStep PathwayStep @relation(fields: [pathwayStepId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([pathwayStepId, skillId])
  @@index([skillId])
}

model Resource {
  id                String             @id @default(uuid())
  title             String
  description       String?
  url               String
  type              ResourceType
  provider          String
  costStatus        ResourceCostStatus @default(UNKNOWN)
  certificationCost Decimal?
  curationRationale String
  lastCheckedDate   DateTime
  status            ResourceStatus     @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  pathwaySteps PathwayStepResource[]
  skills       ResourceSkill[]
}

model PathwayStepResource {
  pathwayStepId String
  resourceId    String

  pathwayStep PathwayStep @relation(fields: [pathwayStepId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([pathwayStepId, resourceId])
  @@index([resourceId])
}

model ResourceSkill {
  resourceId String
  skillId    String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([resourceId, skillId])
  @@index([skillId])
}

model UserPathway {
  id          String   @id @default(uuid())
  userId      String
  careerId    String
  isActive    Boolean  @default(false)
  startedAt   DateTime @default(now())
  startStepId String?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  career    Career       @relation(fields: [careerId], references: [id], onDelete: Cascade)
  startStep PathwayStep? @relation(fields: [startStepId], references: [id], onDelete: SetNull)

  @@unique([userId, careerId])
  @@index([startStepId])
}

model UserPathwayStep {
  id            String            @id @default(uuid())
  userId        String
  pathwayStepId String
  status        PathwayStepStatus @default(NOT_STARTED)
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathwayStep PathwayStep @relation(fields: [pathwayStepId], references: [id], onDelete: Cascade)

  @@unique([userId, pathwayStepId])
  @@index([userId])
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  progress UserSkillProgress[]

  @@unique([userId, skillId])
  @@index([userId])
}

model UserSkillProgress {
  id           String              @id @default(uuid())
  userSkillId  String
  assessmentId String?
  rating       Int?
  source       SkillProgressSource
  createdAt    DateTime            @default(now())

  userSkill  UserSkill   @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([userSkillId, createdAt])
}

model Assessment {
  id            String           @id @default(uuid())
  userId        String
  pathwayStepId String?
  status        AssessmentStatus @default(IN_PROGRESS)
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathwayStep PathwayStep? @relation(fields: [pathwayStepId], references: [id], onDelete: SetNull)

  responses AssessmentResponse[]
  progress  UserSkillProgress[]

  @@index([userId])
  @@index([pathwayStepId])
}

model AssessmentQuestion {
  id        String   @id @default(uuid())
  skillId   String
  question  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill     Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([skillId])
}

model AssessmentResponse {
  id           String   @id @default(uuid())
  assessmentId String
  questionId   String
  rating       Int?
  createdAt    DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model ContentFeedback {
  id          String            @id @default(uuid())
  category    FeedbackCategory
  section     FeedbackSection   @default(GENERAL)
  careerId    String?
  description String
  userEmail   String?
  platform    FeedbackPlatform?
  status      FeedbackStatus    @default(NEW)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  career Career? @relation(fields: [careerId], references: [id], onDelete: SetNull)

  @@index([careerId])
  @@index([status])
}

model Source {
  id            String    @id @default(uuid())
  name          String
  url           String?
  lastCheckedAt DateTime?
  verifiedById  String?

  verifiedBy User? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  outlookData OutlookData[]

  @@index([verifiedById])
}

model ContentRevision {
  id          String         @id @default(uuid())
  careerId    String
  version     Int
  snapshot    Json
  status      RevisionStatus @default(DRAFT)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  career    Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])
  reviews   Review[]

  @@index([careerId])
  @@index([createdById])
}

model Review {
  id         String         @id @default(uuid())
  revisionId String
  reviewerId String
  decision   ReviewDecision
  note       String?
  createdAt  DateTime       @default(now())

  revision ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  reviewer User            @relation(fields: [reviewerId], references: [id])

  @@index([revisionId])
  @@index([reviewerId])
}

model StaffInvite {
  id          String    @id @default(uuid())
  email       String
  role        Role
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User @relation(fields: [invitedById], references: [id])

  @@index([email])
  @@index([invitedById])
}
