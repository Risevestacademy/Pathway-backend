# ─────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────

# development | test | staging | production
# `test` and `development` are the only envs that allow MAIL_DRIVER=log.
NODE_ENV=development

PORT=3000
API_VERSION=v1
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────

POSTGRES_DB=pathway_dev
POSTGRES_USER=pathway_user
POSTGRES_PASSWORD=pathway_password
POSTGRES_PORT=5432

DATABASE_URL="postgresql://pathway_user:pathway_password@localhost:5432/pathway_dev?schema=public"

# ─────────────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────────────

# JWT_REFRESH_SECRET must differ from JWT_ACCESS_SECRET (validated at boot).
JWT_ACCESS_SECRET=access-secret
JWT_REFRESH_SECRET=refresh-secret

# Any positive duration: 15m, 1h, 7d, "30 days", etc.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─────────────────────────────────────────────────────────────────────
# Sentry (optional)
# ─────────────────────────────────────────────────────────────────────

# Leave blank to disable Sentry.
SENTRY_DSN=https://
SENTRY_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────────

# Default window (ms) and per-window limits.
# THROTTLE_AUTH_LIMIT applies only to routes tagged with @AuthThrottle().
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10
THROTTLE_FEEDBACK_LIMIT=5

# ─────────────────────────────────────────────────────────────────────
# Email delivery
# ─────────────────────────────────────────────────────────────────────

# resend | mailersend | log
# `log` prints emails to the console and is allowed only in
# NODE_ENV=development or NODE_ENV=test.
MAIL_DRIVER=resend

# Required only when MAIL_DRIVER=mailersend.
MAILERSEND_API_KEY=mlsn

# Required only when MAIL_DRIVER=resend.
# Get it from https://resend.com/api-keys.
RESEND_API_KEY=rsnd_sk_1e3b0d8c7f5a4e9b9c6f2e8d1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p7q8r9s0t

# The sending identity. The domain part MUST match a domain (or subdomain)
# verified with whichever provider is active (MailerSend or Resend).
# Resend recommends a dedicated subdomain like mail.yourdomain.com to keep
# transactional reputation separate from other email.
EMAIL_FROM_ADDRESS=noreply@mail.path-way.app
EMAIL_FROM_NAME=Pathway

STAFF_INVITE_URL=http://localhost:5173/accept-invite

# Frontend URL used in the password reset email.
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# ─────────────────────────────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────────────────────────────

# Comma-separated list. Each entry must end in .apps.googleusercontent.com.
GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,mobile-client-id.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────────────
# Admin seed (local only)
# ─────────────────────────────────────────────────────────────────────

# Used by the seed script. Do not commit real admin credentials.
ADMIN_EMAIL=admin@pathway.dev
ADMIN_PASSWORD=admin-password

# ─────────────────────────────────────────────────────────────────────
# Analytics (PostHog)
# ─────────────────────────────────────────────────────────────────────

# When false, no PostHog client is constructed and no network calls are made.
ANALYTICS_ENABLED=true

# Required only when ANALYTICS_ENABLED=true.
# Get it from Project Settings → API Keys in PostHog.
POSTHOG_API_KEY=phc_...

# Defaults to https://eu.i.posthog.com (EU/GDPR) if omitted.
# Use https://us.i.posthog.com for US hosting.
# Local dev: http://localhost:8000 if running PostHog via Docker.
POSTHOG_HOST=<host from project settings>