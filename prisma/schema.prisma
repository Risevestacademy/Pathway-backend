generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ResourceType {
  COURSE
  CERTIFICATION
  ARTICLE
  VIDEO
  BOOK
}

enum PathwayStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SkillProgressSource {
  INITIAL_ASSESSMENT
  STEP_ASSESSMENT
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum CareerStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum TargetLevel {
  STUDENT
  RECENT_GRAD
  EARLY_CAREER
}

enum EducationLevel {
  SECONDARY_SCHOOL
  DIPLOMA
  BACHELOR_IN_PROGRESS
  BACHELOR
  MASTERS
  OTHER
}

enum InternshipCount {
  NONE
  ONE
  TWO
  THREE_PLUS
}

enum ExperienceYears {
  ZERO
  UNDER_ONE
  ONE_TO_TWO
  THREE_PLUS
}

enum OutlookType {
  SALARY
  EMPLOYMENT_GROWTH
  DEMAND
}

enum Demand {
  LOW
  MEDIUM
  HIGH
}

enum ResourceCostStatus {
  FREE
  PAID
  UNKNOWN
}

enum ResourceStatus {
  ACTIVE
  WITHDRAWN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  assessments     Assessment[]
  userSkills      UserSkill[]
  pathways        UserPathway[]
  pathwayProgress UserPathwayStep[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenHash])
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careerSkills      CareerSkill[]
  pathwayStepSkills PathwayStepSkill[]
  resourceSkills    ResourceSkill[]
  questions         AssessmentQuestion[]
  userSkills        UserSkill[]
}

model Field {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  careers Career[]
}

model Career {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  title                String
  description          String // card summary
  roleSummary          String // "What the role involves"
  exampleActivities    String[] // "Example work activities"
  typicalEducationNote String? // "Degree in computing... or bootcamps/self-study"
  certificationsNote   String? // "Rarely required. Portfolio matters more."

  fieldId      String
  field        Field         @relation(fields: [fieldId], references: [id])
  targetLevels TargetLevel[]

  status      CareerStatus @default(DRAFT)
  publishedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  version     Int          @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills       CareerSkill[]
  outlook      OutlookData[]
  pathway      Pathway?
  userPathways UserPathway[]
}

model CareerSkill {
  careerId String
  skillId  String

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([careerId, skillId])
}

model OutlookData {
  id       String @id @default(uuid())
  careerId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  type      OutlookType
  geography String // "United States", "Lagos, Nigeria"
  source    String
  sourceUrl String?
  period    String // "May 2024", "2023–2033", "Q2 2025"

  median          Decimal? @db.Decimal(15, 2)
  percentile25    Decimal? @db.Decimal(15, 2)
  percentile75    Decimal? @db.Decimal(15, 2)
  currency        String?
  payPeriod       String? // "year" | "month"
  grossOrNet      String? // "gross" | "net" | "unspecified"
  experienceLevel String? // "entry-level", "all experience levels"

  // EMPLOYMENT_GROWTH fields
  baseYear       Int?
  baseValue      Int? // e.g. 208 (thousands of jobs)
  projectedYear  Int?
  projectedValue Int? // e.g. 225
  growthPercent  Decimal? @db.Decimal(5, 2) // e.g., 8.00 for +8%

  // DEMAND fields
  demandLevel Demand?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pathway {
  id          String   @id @default(uuid())
  careerId    String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  career Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)
  steps  PathwayStep[]
}

model PathwayStep {
  id          String   @id @default(uuid())
  pathwayId   String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pathway     Pathway               @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  skills      PathwayStepSkill[]
  resources   PathwayStepResource[]
  progress    UserPathwayStep[]
  assessments Assessment[]

  @@unique([pathwayId, order])
}

model PathwayStepSkill {
  pathwayStepId String
  skillId       String

  pathwayStep PathwayStep @relation(fields: [pathwayStepId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([pathwayStepId, skillId])
}

model Resource {
  id                String             @id @default(uuid())
  title             String
  description       String?
  url               String
  type              ResourceType
  provider          String
  costStatus        ResourceCostStatus @default(UNKNOWN)
  certificationCost Decimal?
  curationRationale String
  lastCheckedDate   DateTime
  status            ResourceStatus     @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  pathwaySteps PathwayStepResource[]
  skills       ResourceSkill[]
}

model PathwayStepResource {
  pathwayStepId String
  resourceId    String

  pathwayStep PathwayStep @relation(fields: [pathwayStepId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([pathwayStepId, resourceId])
}

model ResourceSkill {
  resourceId String
  skillId    String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([resourceId, skillId])
}

model UserPathway {
  id        String   @id @default(uuid())
  userId    String
  careerId  String
  isActive  Boolean  @default(false)
  startedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
}

model UserPathwayStep {
  id            String            @id @default(uuid())
  userId        String
  pathwayStepId String
  status        PathwayStepStatus @default(NOT_STARTED)
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathwayStep PathwayStep @relation(fields: [pathwayStepId], references: [id], onDelete: Cascade)

  @@unique([userId, pathwayStepId])
  @@index([userId])
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  progress UserSkillProgress[]

  @@unique([userId, skillId])
  @@index([userId])
}

model UserSkillProgress {
  id           String              @id @default(uuid())
  userSkillId  String
  assessmentId String?
  rating       Int
  source       SkillProgressSource
  createdAt    DateTime            @default(now())

  userSkill  UserSkill   @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  @@index([userSkillId, createdAt])
}

model Assessment {
  id            String           @id @default(uuid())
  userId        String
  pathwayStepId String?
  status        AssessmentStatus @default(IN_PROGRESS)
  startedAt     DateTime         @default(now())
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathwayStep PathwayStep? @relation(fields: [pathwayStepId], references: [id], onDelete: SetNull)

  responses AssessmentResponse[]
  progress  UserSkillProgress[]

  @@index([userId])
  @@index([pathwayStepId])
}

model AssessmentQuestion {
  id        String   @id @default(uuid())
  skillId   String
  question  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill     Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([skillId])
}

model AssessmentResponse {
  id           String   @id @default(uuid())
  assessmentId String
  questionId   String
  rating       Int
  createdAt    DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}
